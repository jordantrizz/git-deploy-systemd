#!/usr/bin/env bash
# ==============================================================================
# git-deploy-systemd — Manage inotify-based git pull watcher via systemd
# ==============================================================================
# Installed at: /usr/local/sbin/git-deploy-systemd
# Config:       /opt/git-deploy/config/sites.conf
# Watcher:      /opt/git-deploy/git-deploy-watcher.sh (generated)
# Service:      git-deploy-watcher.service
# ==============================================================================
set -euo pipefail

VERSION="0.0.1"
SCRIPT_NAME="git-deploy-systemd"

# -- Update sources ------------------------------------------------------
# Default upstream for `update` (overridable on the command line and via the
# GIT_DEPLOY_UPSTREAM_URL / GIT_DEPLOY_UPSTREAM_GIT environment variables).
DEFAULT_UPSTREAM_URL="${GIT_DEPLOY_UPSTREAM_URL:-https://raw.githubusercontent.com/jordantrizz/git-deploy-systemd/main/bin/git-deploy-systemd}"
DEFAULT_UPSTREAM_GIT="${GIT_DEPLOY_UPSTREAM_GIT:-https://github.com/jordantrizz/git-deploy-systemd}"

# -- Relocation prefix ---------------------------------------------------
# GIT_DEPLOY_PREFIX relocates the whole footprint under a directory. Empty in
# production (absolute /usr/local/sbin and /opt paths); the test suite sets it
# to exercise install/update/adopt without touching the host.
PREFIX="${GIT_DEPLOY_PREFIX:-}"

# -- Paths ---------------------------------------------------------------
CLI_PATH="${PREFIX}/usr/local/sbin/${SCRIPT_NAME}"
LIB_DIR="${PREFIX}/opt/git-deploy"
WATCHER_SCRIPT="${LIB_DIR}/git-deploy-watcher.sh"
CONFIG_DIR="${LIB_DIR}/config"
SITES_CONF="${CONFIG_DIR}/sites.conf"
SERVICE_NAME="git-deploy-watcher.service"
SERVICE_PATH="${PREFIX}/etc/systemd/system/${SERVICE_NAME}"
SUDOERS_FILE="${PREFIX}/etc/sudoers.d/git-deploy"
BINARY_CONF="${CONFIG_DIR}/install.conf"   # Tracks source and version
PLUGIN_PATH="${CLI_PATH}.php"              # WordPress MU-Plugin (optional, from same source dir)
PLUGIN_INSTALLS_CONF="${CONFIG_DIR}/plugin-installs.json"  # Registered WordPress install paths

# -- ANSI Colors ---------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
GREY='\033[0;90m'
WHITE='\033[1;37m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# -- Output Helpers ------------------------------------------------------
_success() { echo -e "${GREEN} * ${*}${NC}"; }
_warning() { echo -e "${YELLOW} * ${*}${NC}"; }
_error()   { echo -e "${RED} * ${*}${NC}"; }
_notice()  { echo -e "${MAGENTA} * ${*}${NC}"; }
_info()    { echo -e "${CYAN} * ${*}${NC}"; }
_echo()    { echo -e "${*}"; }

_divider() {
    echo -e "${GREY}------------------------------------------------------------${NC}"
}

# -- Debug ---------------------------------------------------------------
DEBUG=false
_debugf() {
    if [[ "${DEBUG}" == "true" ]]; then
        echo -e "${GREY}[DEBUG] ${*}${NC}" >&2
    fi
}

# -- Dry run -------------------------------------------------------------
# When DRY_RUN=true, every mutating operation below is printed instead of
# performed, so install/update/adopt/remove can be validated in a sandbox.
DRY_RUN=false

# GIT_DEPLOY_TESTING=1 exercises real file operations (under
# GIT_DEPLOY_PREFIX) while bypassing root, systemd, and package installs.
TESTING="${GIT_DEPLOY_TESTING:-0}"

# -- Run a mutating command (or print it under --dry-run) ----------------
run() {
    if [[ "${DRY_RUN}" == "true" ]]; then
        _info "[dry-run] $(printf '%q ' "$@")"
        return 0
    fi
    "$@"
}

# -- systemctl wrapper (no-op in the test sandbox) -----------------------
run_systemctl() {
    if [[ "${TESTING}" == "1" ]]; then
        _info "[test] systemctl $*"
        return 0
    fi
    run systemctl "$@"
}

# -- Write a file from stdin (or skip under --dry-run) -------------------
write_file() {
    local path="$1"
    if [[ "${DRY_RUN}" == "true" ]]; then
        _info "[dry-run] write ${path}"
        cat >/dev/null
        return 0
    fi
    mkdir -p "$(dirname "${path}")"
    cat > "${path}"
}

# -- Run an in-place sed edit (or skip under --dry-run) ------------------
run_sed_i() {
    if [[ "${DRY_RUN}" == "true" ]]; then
        _info "[dry-run] sed -i $*"
        return 0
    fi
    sed -i "$@"
}

# -- Logging -------------------------------------------------------------
_log() {
    local msg="$1"
    if [[ "${DRY_RUN}" != "true" && "${TESTING}" != "1" ]]; then
        logger -t "${SCRIPT_NAME}" "${msg}"
    fi
    echo -e "${GREY}[$(date '+%Y-%m-%d %H:%M:%S')] ${msg}${NC}" >&2
}

# ==============================================================================
# UTILITY FUNCTIONS
# ==============================================================================

# -- Check if running as root --------------------------------------------
require_root() {
    if [[ "${DRY_RUN}" == "true" || "${TESTING}" == "1" ]]; then
        _debugf "require_root: bypassed (dry-run or testing)"
        return 0
    fi
    if [[ $EUID -ne 0 ]]; then
        _error "This command must be run as root (sudo)."
        exit 1
    fi
}

# -- Detect OS -----------------------------------------------------------
detect_os() {
    if [[ -f /etc/os-release ]]; then
        # shellcheck source=/dev/null
        . /etc/os-release
        echo "${ID}"
    else
        echo "unknown"
    fi
}

# -- Get package manager command -----------------------------------------
get_pkg_manager_install_cmd() {
    local os_id
    os_id=$(detect_os)
    case "${os_id}" in
        debian|ubuntu)  echo "apt-get install -y" ;;
        centos|rhel|rocky|almalinux|fedora)
            if command -v dnf &>/dev/null; then
                echo "dnf install -y"
            else
                echo "yum install -y"
            fi
            ;;
        arch)           echo "pacman -S --noconfirm" ;;
        *)              echo "" ;;
    esac
}

# -- Check if inotify-tools is installed ---------------------------------
has_inotifywait() {
    command -v inotifywait &>/dev/null
}

# -- Install inotify-tools -----------------------------------------------
install_inotify_tools() {
    if [[ "${DRY_RUN}" == "true" || "${TESTING}" == "1" ]]; then
        _info "Skipping inotify-tools install (dry-run/testing)"
        return 0
    fi
    local pkg_cmd
    pkg_cmd=$(get_pkg_manager_install_cmd)
    _debugf "install_inotify_tools: pkg_cmd=${pkg_cmd}"

    if [[ -z "${pkg_cmd}" ]]; then
        _error "Could not detect package manager. Please install inotify-tools manually."
        return 1
    fi

    _notice "Installing inotify-tools..."
    if ${pkg_cmd} inotify-tools; then
        _success "inotify-tools installed successfully."
        _log "install: inotify-tools installed via ${pkg_cmd}"
        return 0
    else
        _error "Failed to install inotify-tools."
        return 1
    fi
}

# -- Fetch a URL to a file (curl or wget) --------------------------------
fetch_url() {
    local url="$1" dest="$2"
    if command -v curl &>/dev/null; then
        curl -fsSL "${url}" -o "${dest}"
    elif command -v wget &>/dev/null; then
        wget -qO "${dest}" "${url}"
    else
        _error "Neither curl nor wget is available."
        return 1
    fi
}

# -- Verify a file's sha256 against an expected value --------------------
verify_sha256() {
    local file="$1" expected="$2" actual
    actual=$(sha256sum "${file}" 2>/dev/null | awk '{print $1}')
    if [[ -z "${actual}" || "${actual}" != "${expected}" ]]; then
        _error "sha256 mismatch (expected ${expected}, got ${actual:-none})"
        return 1
    fi
    _success "sha256 verified."
}

# -- Clone the project repo (shallow) into a temp dir --------------------
fetch_git_repo() {
    local repo="$1" dest="$2"
    if ! command -v git &>/dev/null; then
        _error "git is not available."
        return 1
    fi
    git clone --depth 1 --quiet "${repo}" "${dest}"
}

# -- Set a key=value in a config file (replace, else append) -------------
conf_set() {
    local file="$1" key="$2" value="$3"
    if [[ "${DRY_RUN}" == "true" ]]; then
        _info "[dry-run] set ${key}=${value} in ${file}"
        return 0
    fi
    if grep -q "^${key}=" "${file}" 2>/dev/null; then
        sed -i "s|^${key}=.*|${key}=${value}|" "${file}"
    else
        printf '%s=%s\n' "${key}" "${value}" >> "${file}"
    fi
}

# -- Check if service is active ------------------------------------------
service_is_active() {
    systemctl is-active --quiet "${SERVICE_NAME}" 2>/dev/null
}

service_is_enabled() {
    systemctl is-enabled --quiet "${SERVICE_NAME}" 2>/dev/null
}

# -- Parse sites.conf ----------------------------------------------------
# Returns space-separated list of site names
get_site_names() {
    local conf_file="${1:-${SITES_CONF}}"
    if [[ ! -f "${conf_file}" ]]; then
        return 0
    fi
    grep -oP '^\[\K[^\]]+' "${conf_file}" 2>/dev/null || true
}

# -- Get site path by name -----------------------------------------------
get_site_path() {
    local name="$1"
    local conf_file="${2:-${SITES_CONF}}"
    awk -v name="${name}" '
        BEGIN { found=0 }
        $0 ~ "^\\[" name "\\]" { found=1; next }
        found && $0 ~ "^path=" { sub("^path=",""); print; exit }
        found && $0 ~ "^\\[" { exit }
    ' "${conf_file}" 2>/dev/null
}

# -- Get site user by name -----------------------------------------------
get_site_user() {
    local name="$1"
    local conf_file="${2:-${SITES_CONF}}"
    awk -v name="${name}" '
        BEGIN { found=0 }
        $0 ~ "^\\[" name "\\]" { found=1; next }
        found && $0 ~ "^user=" { sub("^user=",""); print; exit }
        found && $0 ~ "^\\[" { exit }
    ' "${conf_file}" 2>/dev/null
}

# -- Count sites in config -----------------------------------------------
count_sites() {
    local conf_file="${1:-${SITES_CONF}}"
    if [[ ! -f "${conf_file}" ]]; then
        _debugf "count_sites: conf_file not found, returning 0"
        echo "0"
        return
    fi
    local count
    # grep -c prints "0" but exits non-zero when there are no matches; the
    # `|| true` keeps set -e happy without appending a second "0".
    count=$(grep -c '^\[' "${conf_file}" 2>/dev/null || true)
    [[ -z "${count}" ]] && count=0
    _debugf "count_sites: ${count} site(s) in ${conf_file}"
    echo "${count}"
}

# -- Compute dynamic column widths for sites table -----------------------
# Scans sites.conf and computes max widths for NAME, PATH, USER columns.
# Sets global vars: name_w, path_w, user_w (includes +2 padding).
_compute_site_table_widths() {
    name_w=6   # "NAME" (4) + 2 padding
    path_w=6   # "PATH" (4) + 2 padding
    user_w=6   # "USER" (4) + 2 padding

    if [[ ! -f "${SITES_CONF}" ]]; then
        return 0
    fi

    local name path user
    for name in $(get_site_names); do
        path=$(get_site_path "${name}")
        user=$(get_site_user "${name}")
        [[ ${#name} -gt ${name_w} ]] && name_w=${#name}
        [[ ${#path} -gt ${path_w} ]] && path_w=${#path}
        [[ ${#user} -gt ${user_w} ]] && user_w=${#user}
    done

    name_w=$((name_w + 2))
    path_w=$((path_w + 2))
    user_w=$((user_w + 2))
    _debugf "computed table widths: name=${name_w} path=${path_w} user=${user_w}"
}

# -- Print a dashed divider line for the table ---------------------------
_print_table_divider() {
    local name_dashes path_dashes user_dashes
    name_dashes=$(printf '%*s' "${name_w}" '' | tr ' ' '-')
    path_dashes=$(printf '%*s' "${path_w}" '' | tr ' ' '-')
    user_dashes=$(printf '%*s' "${user_w}" '' | tr ' ' '-')
    printf "  %-${name_w}s %-${path_w}s %-${user_w}s\n" \
        "${name_dashes}" "${path_dashes}" "${user_dashes}"
}

# ==============================================================================
# WATCHER SCRIPT GENERATION
# ==============================================================================

generate_watcher_script() {
    _debugf "generate_watcher_script: writing to ${WATCHER_SCRIPT}"
    _notice "Generating watcher script: ${WATCHER_SCRIPT}"

    write_file "${WATCHER_SCRIPT}" << 'WATCHER_EOF'
#!/usr/bin/env bash
# ==============================================================================
# git-deploy-watcher.sh — Auto-generated by git-deploy-systemd
# DO NOT EDIT — Regenerate with: git-deploy-systemd add/remove/install
# ==============================================================================
set -euo pipefail

# -- Run mode ------------------------------------------------------------
# Default (no args): stdout logging, designed for systemd (systemd captures stdout)
# With --daemon:    syslog logging via logger, for manual background runs
DAEMON=false
if [[ "${1:-}" == "--daemon" ]]; then
    DAEMON=true
    shift
fi

SITES_CONF="__SITES_CONF__"
LOG_TAG="git-deploy-watcher"

log_msg() {
    if [[ "${DAEMON}" == "true" ]]; then
        logger -t "${LOG_TAG}" "$1"
    else
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"
    fi
}

# -- Parse sites.conf into arrays -----------------------------------------
declare -A SITE_PATH SITE_USER SITE_WRITE_COMMIT_INFO
SITE_NAMES=()
WATCH_DIRS=()

parse_config() {
    local current_name=""
    SITE_NAMES=()
    WATCH_DIRS=()

    if [[ ! -f "${SITES_CONF}" ]]; then
        log_msg "ERROR: ${SITES_CONF} not found. Exiting."
        exit 1
    fi

    while IFS= read -r line || [[ -n "${line}" ]]; do
        line=$(echo "${line}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
        [[ -z "${line}" || "${line}" == \#* ]] && continue

        if [[ "${line}" =~ ^\[(.+)\]$ ]]; then
            current_name="${BASH_REMATCH[1]}"
            SITE_NAMES+=("${current_name}")
        elif [[ "${line}" =~ ^path=(.+)$ ]]; then
            SITE_PATH["${current_name}"]="${BASH_REMATCH[1]}"
        elif [[ "${line}" =~ ^user=(.+)$ ]]; then
            SITE_USER["${current_name}"]="${BASH_REMATCH[1]}"
        elif [[ "${line}" =~ ^write_commit_info=(.+)$ ]]; then
            SITE_WRITE_COMMIT_INFO["${current_name}"]="${BASH_REMATCH[1]}"
        fi
    done < "${SITES_CONF}"

    # Build unique watch directories (one per site repo root)
    declare -A dir_map
    for name in "${SITE_NAMES[@]}"; do
        local path="${SITE_PATH[${name}]}"
        if [[ -n "${dir_map[${path}]:-}" ]]; then
            continue
        fi
        dir_map["${path}"]=1
        WATCH_DIRS+=("${path}")
    done
}

# -- Look up site by trigger file path ------------------------------------
find_site_by_trigger() {
    local trigger_path="$1"
    for name in "${SITE_NAMES[@]}"; do
        local expected="${SITE_PATH[${name}]}/.git-pull-trigger"
        if [[ "${trigger_path}" == "${expected}" ]]; then
            echo "${name}"
            return 0
        fi
    done
    return 1
}

# -- Main loop ------------------------------------------------------------
main() {
    parse_config

    if [[ ${#WATCH_DIRS[@]} -eq 0 ]]; then
        log_msg "WARNING: No watch directories configured. Waiting for configuration..."
        while [[ ${#WATCH_DIRS[@]} -eq 0 ]]; do
            sleep 30
            parse_config
        done
    fi

    log_msg "Watching ${#WATCH_DIRS[@]} directory(ies) for .git-pull-trigger events: ${WATCH_DIRS[*]}"

    # Watch each site directory for create/close_write/attrib on .git-pull-trigger
    # inotifywait output: /path/to/dir EVENT filename
    local success_count=0 failure_count=0
    while read -r watched_dir event file; do
        # Only process .git-pull-trigger files
        [[ "${file}" != ".git-pull-trigger" ]] && continue

        # Strip trailing slash that inotifywait adds to directory paths
        watched_dir="${watched_dir%/}"
        local trigger_path="${watched_dir}/.git-pull-trigger"
        local site_name
        site_name=$(find_site_by_trigger "${trigger_path}")

        if [[ -z "${site_name}" ]]; then
            log_msg "WARNING: Unrecognized trigger event in ${watched_dir}"
            rm -f "${trigger_path}" 2>/dev/null || true
            continue
        fi

        local repo_path="${SITE_PATH[${site_name}]}"
        local repo_user="${SITE_USER[${site_name}]}"

        log_msg "Triggered: ${site_name} (${repo_path})"

        # Run git pull as the configured user, capturing all output so a
        # failure is diagnosable from journalctl instead of being silent.
        local pull_out="" pull_rc=0
        pull_out=$(sudo -u "${repo_user}" git -C "${repo_path}" pull 2>&1) || pull_rc=$?

        if [[ "${pull_rc}" -eq 0 ]]; then
            log_msg "SUCCESS: git pull for ${site_name} (${repo_path})"
            success_count=$((success_count + 1))
            if [[ -n "${pull_out}" ]]; then
                while IFS= read -r line; do
                    [[ -n "${line}" ]] && log_msg "  ${site_name}: ${line}"
                done <<< "${pull_out}"
            fi

            if [[ "${SITE_WRITE_COMMIT_INFO[${site_name}]:-0}" == "1" ]]; then
                # Write commit info for WordPress deploy banner
                local commit_info_file="${repo_path}/wp-content/uploads/git-deploy-commit-info.json"
                local commit_branch commit_short commit_full commit_msg commit_ts
                commit_branch=$(sudo -u "${repo_user}" git -C "${repo_path}" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
                commit_short=$(sudo -u "${repo_user}" git -C "${repo_path}" log -1 --format='%h' 2>/dev/null || echo "")
                commit_full=$(sudo -u "${repo_user}" git -C "${repo_path}" log -1 --format='%H' 2>/dev/null || echo "")
                commit_msg=$(sudo -u "${repo_user}" git -C "${repo_path}" log -1 --format='%s' 2>/dev/null | sed 's/\\/\\\\/g; s/"/\\"/g' || echo "")
                commit_ts=$(sudo -u "${repo_user}" git -C "${repo_path}" log -1 --format='%ct' 2>/dev/null || echo "")
                mkdir -p "$(dirname "${commit_info_file}")" 2>/dev/null || true
                printf '{"branch":"%s","commit":"%s","commit_full":"%s","message":"%s","timestamp":%s,"deployed_at":"%s"}\n' \
                    "${commit_branch}" "${commit_short}" "${commit_full}" "${commit_msg}" "${commit_ts:-0}" "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" \
                    > "${commit_info_file}"
                chmod 644 "${commit_info_file}" 2>/dev/null || true
                log_msg "Commit info written to ${commit_info_file}"
            fi
        else
            log_msg "FAILURE: git pull for ${site_name} (${repo_path}) (exit ${pull_rc})"
            failure_count=$((failure_count + 1))
            if [[ -n "${pull_out}" ]]; then
                while IFS= read -r line; do
                    [[ -n "${line}" ]] && log_msg "FAILURE ${site_name}: ${line}"
                done <<< "${pull_out}"
            else
                log_msg "FAILURE ${site_name}: git produced no output"
            fi
        fi

        # Remove the one-shot trigger file after processing
        rm -f "${trigger_path}"
        log_msg "Trigger file removed: ${trigger_path}"
        log_msg "Summary: ${success_count} succeeded, ${failure_count} failed since start"
    done < <(inotifywait -m -q -e close_write,create,attrib "${WATCH_DIRS[@]}" 2>/dev/null)
}

main "$@"
WATCHER_EOF

    # The watcher is a standalone artifact; substitute the real config path
    if [[ "${DRY_RUN}" != "true" ]]; then
        sed -i "s|__SITES_CONF__|${SITES_CONF}|" "${WATCHER_SCRIPT}"
    fi

    run chmod +x "${WATCHER_SCRIPT}"
    _log "generate: watcher script written to ${WATCHER_SCRIPT}"
    _success "Watcher script generated."
}

# ==============================================================================
# SYSTEMD SERVICE UNIT
# ==============================================================================

write_service_unit() {
    _debugf "write_service_unit: writing to ${SERVICE_PATH}"
    _notice "Writing systemd service unit: ${SERVICE_PATH}"

    write_file "${SERVICE_PATH}" << SERVICE_EOF
[Unit]
Description=git-deploy inotify watcher
After=network.target

[Service]
Type=simple
ExecStart=${WATCHER_SCRIPT} --daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
SERVICE_EOF

    _log "install: service unit written to ${SERVICE_PATH}"
    _success "Service unit written."
}

# ==============================================================================
# SUDOERS MANAGEMENT
# ==============================================================================

write_sudoers() {
    local conf_file="${SITES_CONF}"
    _debugf "write_sudoers: conf_file=${conf_file}"

    if [[ ! -f "${conf_file}" ]]; then
        return 0
    fi

    _notice "Writing sudoers file: ${SUDOERS_FILE}"

    local content
    content=$(cat << 'SUDOERS_HEADER'
# Managed by git-deploy-systemd — DO NOT EDIT MANUALLY
# Allows root-run watcher service to sudo -u <user> git pull in specific paths

SUDOERS_HEADER
)

    local name path user
    for name in $(get_site_names "${conf_file}"); do
        path=$(get_site_path "${name}" "${conf_file}")
        user=$(get_site_user "${name}" "${conf_file}")
        if [[ -n "${path}" && -n "${user}" ]]; then
            content+="ALL ALL=(root) NOPASSWD: /usr/bin/sudo -u ${user} git -C ${path} pull"$'\n'
        fi
    done

    printf '%s' "${content}" | write_file "${SUDOERS_FILE}"
    run chmod 0440 "${SUDOERS_FILE}"
    _log "install: sudoers file written to ${SUDOERS_FILE}"
    _success "Sudoers file written."
}

remove_sudoers() {
    if [[ -f "${SUDOERS_FILE}" ]]; then
        run rm -f "${SUDOERS_FILE}"
        _success "Sudoers file removed."
    fi
}

# ==============================================================================
# COMMANDS
# ==============================================================================

# -- Version -------------------------------------------------------------
cmd_version() {
    echo "${SCRIPT_NAME} ${VERSION}"
}

# -- Status --------------------------------------------------------------
cmd_status() {
    _debugf "cmd_status: entering"
    echo ""
    _divider
    local current_path
    current_path=$(realpath "$0" 2>/dev/null || readlink -f "$0" 2>/dev/null || echo "$0")
    _echo "${BOLD}${WHITE}  git-deploy-systemd v${VERSION} — ${current_path}${NC}"
    _divider
    echo ""

    # OS Detection
    local os_id
    os_id=$(detect_os)
    _info "OS detected: ${os_id}"

    # inotify-tools
    if has_inotifywait; then
        _success "inotify-tools: installed"
    else
        _warning "inotify-tools: NOT installed"
    fi

    # Config
    if [[ -f "${SITES_CONF}" ]]; then
        _success "Config: ${SITES_CONF}"
    else
        _warning "Config: not found — run 'git-deploy-systemd install'"
    fi

    # Installed version (from the install record)
    if [[ -f "${BINARY_CONF}" ]]; then
        local recorded_version
        recorded_version=$(grep '^version=' "${BINARY_CONF}" 2>/dev/null | head -1 | cut -d= -f2-)
        _info "Installed version: ${recorded_version:-unknown}"
    else
        _info "Installed version: not recorded (run 'git-deploy-systemd install')"
    fi

    # Service
    echo ""
    if systemctl cat "${SERVICE_NAME}" &>/dev/null; then
        local active_str enabled_str
        if service_is_active; then
            active_str="${GREEN}active${NC}"
        else
            active_str="${RED}inactive${NC}"
        fi
        if service_is_enabled; then
            enabled_str="${GREEN}enabled${NC}"
        else
            enabled_str="${RED}disabled${NC}"
        fi
        _info "Service ${SERVICE_NAME}: ${active_str} / ${enabled_str}"
    else
        _warning "Service: not installed — run 'git-deploy-systemd install'"
    fi

    # Registered sites
    echo ""
    if [[ -f "${SITES_CONF}" ]]; then
        local site_names name path user count
        site_names=$(get_site_names)
        count=$(echo "${site_names}" | grep -c . || echo "0")

        if [[ -z "${site_names}" || "${count}" -eq 0 ]]; then
            _warning "No sites registered. Run 'git-deploy-systemd add' to register a site."
        else
            _info "Registered sites (${count}):"
            echo ""
            local name_w path_w user_w
            _compute_site_table_widths
            printf "  %-${name_w}s %-${path_w}s %-${user_w}s\n" "NAME" "PATH" "USER"
            _print_table_divider
            for name in ${site_names}; do
                path=$(get_site_path "${name}")
                user=$(get_site_user "${name}")
                printf "  %-${name_w}s %-${path_w}s %-${user_w}s\n" "${name}" "${path}" "${user}"
            done
            echo ""
        fi
    else
        _warning "No sites registered. Run 'git-deploy-systemd install' first."
    fi

    # MU-Plugin installed sites
    echo ""
    if [[ -f "${PLUGIN_INSTALLS_CONF}" ]]; then
        local plugin_json plugin_count
        plugin_json=$(plugin_get_installs)
        plugin_count=$(echo "${plugin_json}" | jq -r '.installs | length' 2>/dev/null || echo "0")

        if [[ "${plugin_count}" -gt 0 ]]; then
            _info "MU-Plugin installed sites (${plugin_count}):"
            echo ""
            # Compute dynamic widths
            local pl_label_w=6 pl_path_w=6 pl_user_w=6
            for prow in $(echo "${plugin_json}" | jq -r '.installs[] | "\(.label)|\(.path)|\(.user)"' 2>/dev/null); do
                local pl_row_label pl_row_path pl_row_user
                pl_row_label=$(echo "${prow}" | cut -d'|' -f1)
                pl_row_path=$(echo "${prow}" | cut -d'|' -f2)
                pl_row_user=$(echo "${prow}" | cut -d'|' -f3)
                [[ ${#pl_row_label} -gt ${pl_label_w} ]] && pl_label_w=${#pl_row_label}
                [[ ${#pl_row_path} -gt ${pl_path_w} ]] && pl_path_w=${#pl_row_path}
                [[ ${#pl_row_user} -gt ${pl_user_w} ]] && pl_user_w=${#pl_row_user}
            done
            pl_label_w=$((pl_label_w + 2))
            pl_path_w=$((pl_path_w + 2))
            pl_user_w=$((pl_user_w + 2))

            printf "  %-${pl_label_w}s %-${pl_path_w}s %-${pl_user_w}s\n" "LABEL" "WP PATH" "USER"
            local pl_label_dashes pl_path_dashes pl_user_dashes
            pl_label_dashes=$(printf '%*s' "${pl_label_w}" '' | tr ' ' '-')
            pl_path_dashes=$(printf '%*s' "${pl_path_w}" '' | tr ' ' '-')
            pl_user_dashes=$(printf '%*s' "${pl_user_w}" '' | tr ' ' '-')
            printf "  %-${pl_label_w}s %-${pl_path_w}s %-${pl_user_w}s\n" \
                "${pl_label_dashes}" "${pl_path_dashes}" "${pl_user_dashes}"

            for prow in $(echo "${plugin_json}" | jq -r '.installs[] | "\(.label)|\(.path)|\(.user)"' 2>/dev/null); do
                pl_row_label=$(echo "${prow}" | cut -d'|' -f1)
                pl_row_path=$(echo "${prow}" | cut -d'|' -f2)
                pl_row_user=$(echo "${prow}" | cut -d'|' -f3)
                printf "  %-${pl_label_w}s %-${pl_path_w}s %-${pl_user_w}s\n" "${pl_row_label}" "${pl_row_path}" "${pl_row_user}"
            done
            echo ""
        else
            _warning "No MU-Plugin installs registered."
        fi
    else
        _warning "No MU-Plugin installs registered."
    fi

    # Quick setup hint
    if ! has_inotifywait || [[ ! -f "${SITES_CONF}" ]]; then
        echo ""
        _notice "Quick setup:"
        _echo "  ${CYAN}git-deploy-systemd install${NC}"
        _echo "  ${CYAN}git-deploy-systemd add --path /var/www/site1 --user www-data${NC}"
        echo ""
    fi
}

# -- Install -------------------------------------------------------------
cmd_install() {
    require_root

    local force=0
    if [[ "${1:-}" == "--force" ]]; then
        force=1
    fi
    _debugf "cmd_install: force=${force}"

    echo ""
    _divider
    _echo "${BOLD}${WHITE}  git-deploy-systemd install${NC}"
    _divider
    echo ""

    # 1. Self-install binary
    local current_path
    current_path=$(realpath "$0" 2>/dev/null || readlink -f "$0" 2>/dev/null || echo "$0")
    _debugf "cmd_install: current_path=${current_path}, CLI_PATH=${CLI_PATH}"

    if [[ "${current_path}" != "${CLI_PATH}" ]]; then
        _notice "Self-installing to ${CLI_PATH}..."
        run mkdir -p "$(dirname "${CLI_PATH}")"
        run cp "${current_path}" "${CLI_PATH}"
        run chmod +x "${CLI_PATH}"
        _success "Binary installed to ${CLI_PATH}"
    else
        _info "Binary already at ${CLI_PATH}"
    fi

    # Record the source path and version for future updates
    run mkdir -p "$(dirname "${BINARY_CONF}")"
    {
        echo "# Managed by git-deploy-systemd — DO NOT EDIT MANUALLY"
        echo "binary_source=${current_path}"
        echo "install_date=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo "version=${VERSION}"
        echo "upstream_url=${DEFAULT_UPSTREAM_URL}"
    } | write_file "${BINARY_CONF}"
    _log "install: binary_source recorded as ${current_path}"
    _debugf "cmd_install: wrote ${BINARY_CONF}"

    # 1b. Install PHP MU-Plugin (if available alongside the binary)
    local php_source="${current_path}.php"
    if [[ -f "${php_source}" ]]; then
        _notice "Installing MU-Plugin to ${PLUGIN_PATH}..."
        run cp "${php_source}" "${PLUGIN_PATH}"
        _success "MU-Plugin installed to ${PLUGIN_PATH}"
        # Record plugin source in install.conf
        if [[ "${DRY_RUN}" != "true" ]]; then
            sed -i "/^plugin_source=/d" "${BINARY_CONF}" 2>/dev/null || true
            echo "plugin_source=${php_source}" >> "${BINARY_CONF}"
        fi
        _log "install: plugin_source recorded as ${php_source}"
        _debugf "cmd_install: PHP MU-Plugin copied from ${php_source}"
    else
        _info "No MU-Plugin found alongside binary (expected: ${php_source})"
    fi

    # 2. Install inotify-tools if missing
    if ! has_inotifywait; then
        _warning "inotify-tools is not installed."
        install_inotify_tools || exit 1
    else
        _success "inotify-tools already installed."
    fi

    # 3. Create directories
    run mkdir -p "${LIB_DIR}" "${CONFIG_DIR}"
    _success "Directories created: ${LIB_DIR}, ${CONFIG_DIR}"

    # 4. Create empty sites.conf if not exists
    if [[ ! -f "${SITES_CONF}" ]]; then
        run touch "${SITES_CONF}"
        _success "Created empty config: ${SITES_CONF}"
    else
        _info "Config already exists: ${SITES_CONF}"
    fi

    # 5. Write service unit
    write_service_unit

    # 6. Regenerate the watcher (and sudoers) BEFORE touching systemd, so a
    #    systemctl failure cannot leave a stale watcher behind.
    local site_count
    site_count=$(count_sites)
    _debugf "cmd_install: site_count=${site_count}"
    if [[ "${site_count}" -gt 0 ]]; then
        _notice "${site_count} site(s) already configured. Regenerating watcher..."
    fi
    generate_watcher_script
    if [[ "${site_count}" -gt 0 ]]; then
        write_sudoers
    fi

    # 7. Systemd: reload, enable, and (with sites) restart. Best-effort — a
    #    failing or crashing systemctl must not abort the install now that the
    #    files are already in place.
    local systemd_ok=1
    run_systemctl daemon-reload || {
        _warning "systemctl daemon-reload failed"
        systemd_ok=0
    }
    run_systemctl enable "${SERVICE_NAME}" 2>/dev/null || {
        _warning "Could not enable ${SERVICE_NAME}. Try running: systemctl enable ${SERVICE_NAME}"
        systemd_ok=0
    }
    if [[ "${site_count}" -gt 0 ]]; then
        run_systemctl restart "${SERVICE_NAME}" 2>/dev/null || {
            _warning "Could not restart ${SERVICE_NAME}. Check: systemctl status ${SERVICE_NAME}"
            systemd_ok=0
        }
        if service_is_active; then
            _success "Service is running."
        fi
    fi

    # 8. Success summary
    _log "install: completed successfully — ${site_count} site(s) configured"
    echo ""
    _divider
    _echo "${GREEN}${BOLD}  git-deploy-systemd installed successfully.${NC}"
    _divider
    echo ""
    _echo "  CLI:       ${CYAN}${CLI_PATH}${NC}"
    _echo "  Config:    ${CYAN}${SITES_CONF}${NC}"
    _echo "  Watcher:   ${CYAN}${WATCHER_SCRIPT}${NC}"
    _echo "  Service:   ${CYAN}${SERVICE_NAME}${NC}"
    echo ""
    if [[ "${systemd_ok}" -ne 1 ]]; then
        _warning "systemd steps did not complete. The files above are installed;"
        _echo "    once systemd is healthy run: ${CYAN}systemctl daemon-reload && systemctl enable --now ${SERVICE_NAME}${NC}"
    fi
    _echo "  Next step: ${CYAN}git-deploy-systemd add --path /var/www/site1 --user www-data${NC}"
    echo ""
}

# -- Uninstall -----------------------------------------------------------
cmd_uninstall() {
    require_root

    local force=0
    local keep_triggers=0

    for arg in "$@"; do
        case "${arg}" in
            --force) force=1 ;;
            --keep-triggers) keep_triggers=1 ;;
        esac
    done
    _debugf "cmd_uninstall: force=${force}, keep_triggers=${keep_triggers}"

    echo ""
    _divider
    _echo "${BOLD}${RED}  git-deploy-systemd UNINSTALL${NC}"
    _divider
    echo ""

    # 1. Confirmation
    if [[ "${force}" -ne 1 ]]; then
        _warning "This will permanently remove:"
        echo ""
        _echo "    - ${YELLOW}${SERVICE_NAME}${NC} (stopped and disabled)"
        _echo "    - ${YELLOW}${LIB_DIR}${NC} (watcher script)"
        _echo "    - ${YELLOW}${CONFIG_DIR}${NC} (sites.conf and all configuration)"
        _echo "    - ${YELLOW}${CLI_PATH}${NC} (this command)"
        _echo "    - ${YELLOW}${SUDOERS_FILE}${NC} (sudoers entries, if any)"
        echo ""
        read -r -p "  Type 'yes' to confirm: " confirm
        if [[ "${confirm}" != "yes" ]]; then
            _notice "Uninstall cancelled."
            exit 0
        fi
        echo ""
    fi

    # 2. Stop and disable service
    if systemctl cat "${SERVICE_NAME}" &>/dev/null; then
        _notice "Stopping and disabling ${SERVICE_NAME}..."
        run_systemctl stop "${SERVICE_NAME}" 2>/dev/null || true
        run_systemctl disable "${SERVICE_NAME}" 2>/dev/null || true
        _success "Service stopped and disabled."
    fi

    # 3. Remove unit file
    if [[ -f "${SERVICE_PATH}" ]]; then
        run rm -f "${SERVICE_PATH}"
        run_systemctl daemon-reload || _warning "systemctl daemon-reload failed"
        _success "Removed: ${SERVICE_PATH}"
    fi

    # 4. Handle trigger files
    if [[ -f "${SITES_CONF}" ]]; then
        local name path
        for name in $(get_site_names); do
            path=$(get_site_path "${name}")
            local trigger_file="${path}/.git-pull-trigger"
            if [[ -f "${trigger_file}" ]]; then
                if [[ "${keep_triggers}" -eq 1 ]]; then
                    _info "Keeping trigger file: ${trigger_file}"
                elif [[ "${force}" -eq 1 ]]; then
                    _info "Leaving trigger file in place: ${trigger_file}"
                else
                    read -r -p "  Delete trigger file '${trigger_file}'? [y/N] " del_trigger
                    if [[ "${del_trigger,,}" == "y" || "${del_trigger,,}" == "yes" ]]; then
                        run rm -f "${trigger_file}"
                        _success "Deleted: ${trigger_file}"
                    else
                        _info "Keeping: ${trigger_file}"
                    fi
                fi
            fi
        done
    fi

    # 5. Remove sudoers
    remove_sudoers

    # 6. Remove lib directory
    if [[ -d "${LIB_DIR}" ]]; then
        run rm -rf "${LIB_DIR}"
        _success "Removed: ${LIB_DIR}"
    fi

    # 7. Remove config directory
    if [[ -d "${CONFIG_DIR}" ]]; then
        run rm -rf "${CONFIG_DIR}"
        _success "Removed: ${CONFIG_DIR}"
    fi

    # 8. Remove self
    if [[ -f "${CLI_PATH}" ]]; then
        run rm -f "${CLI_PATH}"
        _success "Removed: ${CLI_PATH}"
    fi
    if [[ -f "${PLUGIN_PATH}" ]]; then
        run rm -f "${PLUGIN_PATH}"
        _success "Removed: ${PLUGIN_PATH}"
    fi

    # 9. Final status
    _log "uninstall: all files and service removed"
    echo ""
    _divider
    _echo "${GREEN}${BOLD}  git-deploy-systemd has been uninstalled.${NC}"
    _divider
    echo ""
    _info "Left in place (not removed):"
    _echo "    - .git-pull-trigger files in each repository (use --keep-triggers to suppress prompts)"
    _echo "    - inotify-tools package (not uninstalled — may be used by other tools)"
    echo ""
}

# -- Print re-run command for cmd_add failures ---------------------------
_print_rerun_cmd() {
    local path="$1"
    local user="$2"
    local name="$3"
    local write_ci="$4"

    local cmd="git-deploy-systemd add"
    cmd+=" --path ${path}"
    cmd+=" --user ${user}"
    cmd+=" --name ${name}"
    if [[ "${write_ci}" == "1" ]]; then
        cmd+=" --write-commit-info"
    fi

    echo ""
    _notice "To re-run after fixing the issue:"
    _echo "  ${CYAN}${cmd}${NC}"
    echo ""
}

# -- Add -----------------------------------------------------------------
cmd_add() {
    require_root
    _debugf "cmd_add: entering, args: $*"

    local site_path=""
    local site_user=""
    local site_name=""
    local write_commit_info=0

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --path)
                site_path="$2"
                shift 2
                ;;
            --user)
                site_user="$2"
                shift 2
                ;;
            --name)
                site_name="$2"
                shift 2
                ;;
            --write-commit-info)
                write_commit_info=1
                shift
                ;;
            *)
                _error "Unknown argument: $1"
                echo "Usage: git-deploy-systemd add --path <path> --user <user> [--name <name>] [--write-commit-info]"
                exit 1
                ;;
        esac
    done

    # Interactive prompts if flags not provided
    if [[ -z "${site_path}" ]]; then
        read -r -p "Repository path (e.g. /var/www/site1): " site_path
    fi

    if [[ -z "${site_user}" ]]; then
        read -r -p "System user to run git pull as (e.g. www-data): " site_user
    fi

    if [[ -z "${site_name}" ]]; then
        # Default name from basename of path
        site_name=$(basename "${site_path}")
        read -r -p "Site label [${site_name}]: " input_name
        if [[ -n "${input_name}" ]]; then
            site_name="${input_name}"
        fi
    fi

    # Validate path
    _debugf "cmd_add: validating path='${site_path}' user='${site_user}' name='${site_name}'"
    if [[ ! -d "${site_path}" ]]; then
        _error "Path does not exist: ${site_path}"
        _print_rerun_cmd "${site_path}" "${site_user}" "${site_name}" "${write_commit_info}"
        exit 1
    fi

    # Validate user (do this first so we can sudo as them for safe.directory git check)
    if ! id "${site_user}" &>/dev/null; then
        _error "System user does not exist: ${site_user}"
        _print_rerun_cmd "${site_path}" "${site_user}" "${site_name}" "${write_commit_info}"
        exit 1
    fi
    _success "Valid system user: ${site_user}"

    # Validate git repo (run as target user to avoid git safe.directory restrictions)
    if ! sudo -u "${site_user}" git -C "${site_path}" rev-parse --is-inside-work-tree &>/dev/null; then
        _error "Not a git repository: ${site_path}"
        _print_rerun_cmd "${site_path}" "${site_user}" "${site_name}" "${write_commit_info}"
        exit 1
    fi
    _success "Valid git repository: ${site_path}"

    # Check for duplicate name
    if [[ -f "${SITES_CONF}" ]]; then
        for existing in $(get_site_names); do
            if [[ "${existing}" == "${site_name}" ]]; then
                _error "A site named '${site_name}' already exists. Use --name to specify a different label."
                _print_rerun_cmd "${site_path}" "${site_user}" "${site_name}" "${write_commit_info}"
                exit 1
            fi
        done
    fi

    # Ensure install is done first
    if [[ ! -d "${CONFIG_DIR}" ]]; then
        _warning "git-deploy-systemd is not yet installed. Running install first..."
        cmd_install --force
    fi

    # Append to sites.conf
    _notice "Registering site in ${SITES_CONF}..."
    if [[ "${DRY_RUN}" == "true" ]]; then
        _info "[dry-run] append site [${site_name}] to ${SITES_CONF}"
    else
        {
            echo ""
            echo "[${site_name}]"
            echo "path=${site_path}"
            echo "user=${site_user}"
            if [[ "${write_commit_info}" == "1" ]]; then
                echo "write_commit_info=true"
            fi
        } >> "${SITES_CONF}"
    fi
    _success "Site registered: [${site_name}]"

    # Create trigger file
    local trigger_file="${site_path}/.git-pull-trigger"
    if [[ ! -f "${trigger_file}" ]]; then
        run touch "${trigger_file}"
        # Set appropriate permissions for PHP (www-data) write access
        run chown "${site_user}" "${trigger_file}" 2>/dev/null || true
        # If www-data exists and is different, add group write
        if id "www-data" &>/dev/null && [[ "${site_user}" != "www-data" ]]; then
            run chgrp "www-data" "${trigger_file}" 2>/dev/null || true
            run chmod g+w "${trigger_file}" 2>/dev/null || true
        fi
        _success "Trigger file created: ${trigger_file}"
    else
        _info "Trigger file already exists: ${trigger_file}"
    fi

    # Reminders
    echo ""
    _notice "REMINDERS:"
    _echo "  1. Add .git-pull-trigger to your repo's .gitignore:"
    _echo "     ${CYAN}echo \".git-pull-trigger\" >> ${site_path}/.gitignore${NC}"
    _echo ""
    _echo "  2. Ensure the deploy user (${site_user}) has permission to git pull:"
    _echo "     - SSH key registered with the remote, or"
    _echo "     - HTTPS credential cached"
    echo ""

    # Regenerate watcher
    generate_watcher_script

    # Write sudoers
    write_sudoers

    # Reload/restart service
    _notice "Restarting ${SERVICE_NAME}..."
    run_systemctl restart "${SERVICE_NAME}" 2>/dev/null || {
        _warning "Could not restart service. Starting it now..."
        run_systemctl start "${SERVICE_NAME}" 2>/dev/null || {
            _warning "Could not start ${SERVICE_NAME}. Check: systemctl status ${SERVICE_NAME}"
        }
    }

    if service_is_active; then
        _success "Service is running. Deploy watcher is active for ${site_name}."
        _log "add: registered site '${site_name}' at ${site_path} (user=${site_user}) — service active"
    else
        _warning "Service may not be running. Check: systemctl status ${SERVICE_NAME}"
        _log "add: registered site '${site_name}' at ${site_path} (user=${site_user}) — service NOT running"
    fi
}

# -- Remove --------------------------------------------------------------
cmd_remove() {
    require_root
    _debugf "cmd_remove: entering, path='${1:-}'"

    local remove_path="$1"

    if [[ -z "${remove_path}" ]]; then
        _error "Usage: git-deploy-systemd remove <path>"
        _echo "  Provide the repository path to remove (e.g. /var/www/site1)"
        exit 1
    fi

    # Normalize path
    remove_path=$(realpath "${remove_path}" 2>/dev/null || echo "${remove_path}")

    if [[ ! -f "${SITES_CONF}" ]]; then
        _error "No sites configured. ${SITES_CONF} does not exist."
        exit 1
    fi

    # Find the site name by path
    local found_name=""
    for name in $(get_site_names); do
        local spath
        spath=$(get_site_path "${name}")
        if [[ "${spath}" == "${remove_path}" ]]; then
            found_name="${name}"
            break
        fi
    done

    if [[ -z "${found_name}" ]]; then
        _error "No site found with path: ${remove_path}"
        _echo "  Registered sites:"
        for name in $(get_site_names); do
            _echo "    ${name}: $(get_site_path "${name}")"
        done
        exit 1
    fi

    echo ""
    _notice "Removing site '${found_name}' (${remove_path}) from config..."

    # Remove the block from sites.conf
    local tmp_conf
    tmp_conf=$(mktemp)
    local skip=0
    while IFS= read -r line || [[ -n "${line}" ]]; do
        if [[ "${line}" =~ ^\[${found_name}\]$ ]]; then
            skip=1
            continue
        fi
        if [[ "${skip}" -eq 1 ]]; then
            if [[ "${line}" =~ ^\[ ]] || [[ -z "${line}" && "${skip}" -eq 1 ]]; then
                # Next section or empty line after block — stop skipping
                skip=0
                [[ -z "${line}" ]] && continue
            else
                continue
            fi
        fi
        echo "${line}" >> "${tmp_conf}"
    done < "${SITES_CONF}"

    run mv "${tmp_conf}" "${SITES_CONF}"
    _success "Removed [${found_name}] from ${SITES_CONF}"

    # Handle trigger file
    local trigger_file="${remove_path}/.git-pull-trigger"
    if [[ -f "${trigger_file}" ]]; then
        read -r -p "  Delete trigger file '${trigger_file}'? [y/N] " del_trigger
        if [[ "${del_trigger,,}" == "y" || "${del_trigger,,}" == "yes" ]]; then
            run rm -f "${trigger_file}"
            _success "Deleted: ${trigger_file}"
        else
            _info "Keeping: ${trigger_file}"
        fi
    fi

    # Regenerate watcher
    generate_watcher_script

    # Rewrite sudoers
    if [[ $(count_sites) -gt 0 ]]; then
        write_sudoers
    else
        remove_sudoers
    fi

    # Restart service
    if [[ $(count_sites) -gt 0 ]]; then
        _notice "Restarting ${SERVICE_NAME}..."
        run_systemctl restart "${SERVICE_NAME}" 2>/dev/null || true
        if service_is_active; then
            _success "Service restarted."
        fi
    else
        _notice "No sites remaining. Stopping ${SERVICE_NAME}..."
        run_systemctl stop "${SERVICE_NAME}" 2>/dev/null || true
        _info "Service stopped (no sites to watch)."
    fi

    echo ""
    _log "remove: unregistered site '${found_name}' at ${remove_path}"
    _success "Site '${found_name}' removed."
}

# -- Adopt ---------------------------------------------------------------
# Take over an existing (possibly unknown-version) install without losing
# configuration. Detected files are backed up before anything changes.
cmd_adopt() {
    require_root
    _debugf "cmd_adopt: entering, args: $*"

    local force=0
    for arg in "$@"; do
        case "${arg}" in
            --force) force=1 ;;
        esac
    done

    echo ""
    _divider
    _echo "${BOLD}${WHITE}  git-deploy-systemd adopt${NC}"
    _divider
    echo ""

    # Detect an existing install (legacy or otherwise)
    local found=0
    local -a detected=()
    local f
    for f in "${LIB_DIR}/${SCRIPT_NAME}" "${CLI_PATH}" "${SITES_CONF}" \
             "${WATCHER_SCRIPT}" "${SERVICE_PATH}" "${SUDOERS_FILE}" "${BINARY_CONF}"; do
        if [[ -f "${f}" ]]; then
            detected+=("${f}")
            found=1
        fi
    done

    if [[ "${found}" -eq 0 ]]; then
        _warning "No existing install detected — nothing to adopt."
        _echo "  For a fresh install run: ${CYAN}git-deploy-systemd install${NC}"
        exit 0
    fi

    _info "Detected existing files:"
    for f in "${detected[@]}"; do
        _echo "    ${f}"
    done
    echo ""

    # Report the old version and site count when available
    local old_version="unknown"
    if [[ -f "${BINARY_CONF}" ]]; then
        old_version=$(grep '^version=' "${BINARY_CONF}" 2>/dev/null | cut -d= -f2-)
        [[ -z "${old_version}" ]] && old_version="unknown"
    fi
    local old_sites=0
    if [[ -f "${SITES_CONF}" ]]; then
        old_sites=$(count_sites)
    fi
    _info "Existing version: ${old_version} (${old_sites} site(s) configured)"

    if [[ "${force}" -ne 1 ]]; then
        read -r -p "  Adopt this install and switch to git-deploy-systemd ${VERSION}? [y/N] " confirm
        if [[ "${confirm}" != "y" && "${confirm}" != "Y" ]]; then
            _notice "Adopt cancelled."
            exit 0
        fi
    fi

    # Back up every detected file before touching anything
    local ts backup
    ts=$(date -u +%Y%m%dT%H%M%SZ)
    for f in "${detected[@]}"; do
        backup="${f}.pre-adopt.${ts}"
        run cp -a "${f}" "${backup}"
        _success "Backed up ${f} -> ${backup}"
    done

    # Install/upgrade the binary at the new location
    local current_path
    current_path=$(realpath "$0" 2>/dev/null || readlink -f "$0" 2>/dev/null || echo "$0")
    if [[ "${current_path}" != "${CLI_PATH}" ]]; then
        _notice "Installing binary to ${CLI_PATH}..."
        run mkdir -p "$(dirname "${CLI_PATH}")"
        run cp "${current_path}" "${CLI_PATH}"
        run chmod +x "${CLI_PATH}"
        _success "Binary installed to ${CLI_PATH}"
    fi

    # Write the install record, marking provenance
    run mkdir -p "$(dirname "${BINARY_CONF}")"
    {
        echo "# Managed by git-deploy-systemd — DO NOT EDIT MANUALLY"
        echo "binary_source=${current_path}"
        echo "install_date=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo "version=${VERSION}"
        echo "upstream_url=${DEFAULT_UPSTREAM_URL}"
        echo "adopted=true"
        echo "adopted_from_version=${old_version}"
    } | write_file "${BINARY_CONF}"

    # Regenerate watcher, service, and sudoers from the preserved config
    generate_watcher_script
    write_service_unit
    if [[ -f "${SITES_CONF}" && "$(count_sites)" -gt 0 ]]; then
        write_sudoers
    fi

    # Reload systemd and restart the watcher (best-effort)
    run_systemctl daemon-reload || _warning "systemctl daemon-reload failed"
    run_systemctl enable "${SERVICE_NAME}" 2>/dev/null || true
    if [[ -f "${SITES_CONF}" && "$(count_sites)" -gt 0 ]]; then
        run_systemctl restart "${SERVICE_NAME}" 2>/dev/null || true
    fi

    _log "adopt: adopted existing install (was ${old_version}) — now ${VERSION}"
    echo ""
    _divider
    _echo "${GREEN}${BOLD}  Adopted. git-deploy-systemd ${VERSION} is now installed.${NC}"
    _divider
    echo ""
    _echo "  CLI:     ${CYAN}${CLI_PATH}${NC}"
    _echo "  Config:  ${CYAN}${SITES_CONF}${NC} (preserved)"
    _echo "  Watcher: ${CYAN}${WATCHER_SCRIPT}${NC}"
    _echo "  Service: ${CYAN}${SERVICE_NAME}${NC}"
    echo ""
}

# -- Update --------------------------------------------------------------
cmd_update() {
    require_root
    _debugf "cmd_update: entering, args: $*"

    local source_path=""
    local from_url=""
    local from_git=0
    local git_repo="${DEFAULT_UPSTREAM_GIT}"
    local sha256=""
    local force=0

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --from)
                source_path="$2"
                shift 2
                ;;
            --from-url)
                from_url="$2"
                shift 2
                ;;
            --from-git)
                from_git=1
                if [[ $# -ge 2 && "${2}" != -* ]]; then
                    git_repo="$2"
                    shift
                fi
                shift
                ;;
            --sha256)
                sha256="$2"
                shift 2
                ;;
            --force)
                force=1
                shift
                ;;
            *)
                shift
                ;;
        esac
    done

    echo ""
    _divider
    _echo "${BOLD}${WHITE}  git-deploy-systemd update${NC}"
    _divider
    echo ""

    # When no source was given, prefer the recorded upstream, then the
    # recorded local source, and finally the project's default upstream.
    local conf_upstream=""
    if [[ -f "${BINARY_CONF}" ]]; then
        conf_upstream=$(grep '^upstream_url=' "${BINARY_CONF}" 2>/dev/null | cut -d= -f2-)
    fi
    if [[ -z "${source_path}" && -z "${from_url}" && "${from_git}" -eq 0 ]]; then
        if [[ -n "${conf_upstream}" ]]; then
            from_url="${conf_upstream}"
        else
            source_path=$(grep '^binary_source=' "${BINARY_CONF}" 2>/dev/null | cut -d= -f2-)
            if [[ -z "${source_path}" ]]; then
                from_url="${DEFAULT_UPSTREAM_URL}"
            fi
        fi
    fi

    # Resolve URL / git sources into a local temp file
    local tmp_dir="" network_source=0
    if [[ -n "${from_url}" ]]; then
        network_source=1
        tmp_dir=$(mktemp -d)
        source_path="${tmp_dir}/${SCRIPT_NAME}"
        _notice "Downloading ${from_url}..."
        if ! fetch_url "${from_url}" "${source_path}"; then
            _error "Failed to download ${from_url}"
            run rm -rf "${tmp_dir}"
            exit 1
        fi
        if [[ -n "${sha256}" ]]; then
            if ! verify_sha256 "${source_path}" "${sha256}"; then
                run rm -rf "${tmp_dir}"
                exit 1
            fi
        fi
        if ! fetch_url "${from_url}.php" "${tmp_dir}/${SCRIPT_NAME}.php" 2>/dev/null; then
            rm -f "${tmp_dir}/${SCRIPT_NAME}.php" 2>/dev/null || true
        fi
    elif [[ "${from_git}" -eq 1 ]]; then
        network_source=1
        tmp_dir=$(mktemp -d)
        _notice "Fetching from git ${git_repo}..."
        if ! fetch_git_repo "${git_repo}" "${tmp_dir}"; then
            _error "Failed to clone ${git_repo}"
            run rm -rf "${tmp_dir}"
            exit 1
        fi
        source_path="${tmp_dir}/bin/${SCRIPT_NAME}"
    fi
    _debugf "cmd_update: source_path=${source_path}, network_source=${network_source}"

    if [[ ! -f "${source_path}" ]]; then
        _error "Source binary not found at: ${source_path}"
        _echo "  Specify a source: git-deploy-systemd update --from-url <url> | --from-git [<repo>] | --from <path>"
        exit 1
    fi

    # Check if update is needed (compare md5sums)
    local src_md5 dst_md5
    src_md5=$(md5sum "${source_path}" 2>/dev/null | awk '{print $1}')
    dst_md5=$(md5sum "${CLI_PATH}" 2>/dev/null | awk '{print $1}')
    _debugf "cmd_update: src_md5=${src_md5} dst_md5=${dst_md5} force=${force}"
    if [[ "${force}" != "1" && -n "${src_md5}" && "${src_md5}" == "${dst_md5}" ]]; then
        _info "Binary is already up to date (md5sum match)."
    else
        # Do ALL work BEFORE overwriting the running binary to avoid bash
        # reading a file being modified under it (produces syntax errors).

        # Read new version from the SOURCE (before copying)
        local new_version old_version
        new_version=$(grep '^VERSION=' "${source_path}" 2>/dev/null | head -1 | cut -d'"' -f2)
        old_version=$(grep '^version=' "${BINARY_CONF}" 2>/dev/null | head -1 | cut -d= -f2-)
        _info "Version: ${old_version:-unknown} -> ${new_version:-unknown}"

        # Re-check dependencies before overwrite
        if ! has_inotifywait; then
            _warning "inotify-tools is not installed."
            install_inotify_tools || exit 1
        fi

        # Regenerate watcher and restart service BEFORE overwriting self
        if [[ -f "${SITES_CONF}" && $(count_sites) -gt 0 ]]; then
            _notice "Regenerating watcher and restarting service..."
            generate_watcher_script
            write_sudoers
            run_systemctl restart "${SERVICE_NAME}" 2>/dev/null || true
            if service_is_active; then
                _success "Service restarted with updated watcher."
            fi
        fi

        # NOW overwrite the binary — last operation before final messages
        if [[ "${force}" == "1" ]]; then
            _notice "Forcing update of ${CLI_PATH} from ${source_path}..."
        else
            _notice "Updating ${CLI_PATH} from ${source_path}..."
        fi
        run cp "${source_path}" "${CLI_PATH}"
        run chmod +x "${CLI_PATH}"
        if [[ "${force}" == "1" ]]; then
            _log "update: forced binary update from ${source_path}"
            _success "Binary forcefully updated."
        else
            _log "update: binary updated from ${source_path}"
            _success "Binary updated successfully."
        fi

        # Update install.conf (safe — it's a different file)
        if [[ -n "${new_version}" && -f "${BINARY_CONF}" ]]; then
            run_sed_i "s/^version=.*/version=${new_version}/" "${BINARY_CONF}" 2>/dev/null || true
            _info "Version: ${new_version}"
        fi
        if [[ -f "${BINARY_CONF}" ]]; then
            run_sed_i "s|^binary_source=.*|binary_source=${source_path}|" "${BINARY_CONF}" 2>/dev/null || true
            if [[ -n "${from_url}" ]]; then
                conf_set "${BINARY_CONF}" upstream_url "${from_url}"
            fi
        fi
    fi

    # -- Update PHP MU-Plugin if available ----------------------------------
    local php_source=""
    if [[ "${network_source}" -ne 1 && -f "${BINARY_CONF}" ]]; then
        php_source=$(grep '^plugin_source=' "${BINARY_CONF}" 2>/dev/null | cut -d= -f2-)
    fi
    # Fallback: derive the plugin path from the binary source. For network
    # sources this is the freshly downloaded/cloned sibling plugin.
    if [[ -z "${php_source}" ]]; then
        php_source="${source_path}.php"
    fi

    if [[ -f "${php_source}" ]]; then
        _debugf "cmd_update: checking MU-Plugin at ${php_source}"
        local php_src_md5 php_dst_md5
        php_src_md5=$(md5sum "${php_source}" 2>/dev/null | awk '{print $1}')
        php_dst_md5=$(md5sum "${PLUGIN_PATH}" 2>/dev/null | awk '{print $1}')
        _debugf "cmd_update: plugin src_md5=${php_src_md5} dst_md5=${php_dst_md5}"

        if [[ "${force}" == "1" || -z "${php_dst_md5}" || "${php_src_md5}" != "${php_dst_md5}" ]]; then
            _notice "Updating MU-Plugin at ${PLUGIN_PATH}..."
            run cp "${php_source}" "${PLUGIN_PATH}"
            _log "update: MU-Plugin updated from ${php_source}"
            _success "MU-Plugin updated."

            # Record plugin source in install.conf
            if [[ -f "${BINARY_CONF}" ]]; then
                conf_set "${BINARY_CONF}" plugin_source "${php_source}"
            fi
        else
            _info "MU-Plugin is already up to date (md5sum match)."
        fi
    else
        _debugf "cmd_update: no MU-Plugin source found at ${php_source}, skipping"
    fi

    # Clean up the temp download/clone
    if [[ -n "${tmp_dir}" ]]; then
        run rm -rf "${tmp_dir}"
    fi

    echo ""

    # -- Verify full file manifest ------------------------------------------
    echo ""
    _divider
    _echo "${BOLD}${WHITE}  File manifest check${NC}"
    _divider
    echo ""

    local -a manifest_paths=(
        "${CLI_PATH}:executable:Core CLI binary"
        "${PLUGIN_PATH}:file:WordPress MU-Plugin"
        "${WATCHER_SCRIPT}:executable:Generated watcher script"
    )

    local manifest_ok=0 manifest_fail=0 item path type label
    for item in "${manifest_paths[@]}"; do
        path="${item%%:*}"
        rest="${item#*:}"
        type="${rest%%:*}"
        label="${rest#*:}"

        case "${type}" in
            file)
                if [[ -f "${path}" ]]; then
                    _success "${label}: ${path}"
                    ((manifest_ok++))
                else
                    _warning "${label}: NOT FOUND — ${path}"
                    ((manifest_fail++))
                fi
                ;;
            executable)
                if [[ -x "${path}" ]]; then
                    _success "${label}: ${path}"
                    ((manifest_ok++))
                else
                    _warning "${label}: MISSING or NOT EXECUTABLE — ${path}"
                    ((manifest_fail++))
                fi
                ;;
            dir)
                if [[ -d "${path}" ]]; then
                    _success "${label}: ${path}"
                    ((manifest_ok++))
                else
                    _warning "${label}: NOT FOUND — ${path}"
                    ((manifest_fail++))
                fi
                ;;
        esac
    done

    echo ""
    _info "Manifest: ${manifest_ok} OK, ${manifest_fail} missing/warnings"
    echo ""

    _success "Update complete."
    # Exit immediately so bash never reads another chunk from the
    # overwritten file, which would cause syntax errors.
    exit 0
}

# -- Update All ----------------------------------------------------------
cmd_update_all() {
    require_root
    _debugf "cmd_update_all: entering, args: $*"

    echo ""
    _divider
    _echo "${BOLD}${WHITE}  git-deploy-systemd update-all${NC}"
    _divider
    echo ""

    # Step 1: Update PHP source on disk (before deploying to WordPress)
    local source_path=""
    if [[ -f "${BINARY_CONF}" ]]; then
        source_path=$(grep '^binary_source=' "${BINARY_CONF}" 2>/dev/null | cut -d= -f2-)
    fi
    if [[ -n "${source_path}" ]]; then
        local php_source="${source_path}.php"
        if [[ -f "${php_source}" ]]; then
            _notice "Updating MU-Plugin source..."
            run cp "${php_source}" "${PLUGIN_PATH}"
            _success "MU-Plugin source updated."
        fi
    fi

    # Step 2: Deploy PHP to all WordPress sites
    _notice "Step 1/2: Updating WordPress sites..."
    cmd_plugin_update "$@"

    # Step 3: Update system files (binary, watcher, service)
    # This will exit after completion to avoid self-overwrite corruption
    _notice "Step 2/2: Updating system files..."
    cmd_update "$@"
    # NOT REACHED — cmd_update calls exit 0
}

# -- List ----------------------------------------------------------------
cmd_list() {
    _debugf "cmd_list: entering"
    if [[ ! -f "${SITES_CONF}" ]]; then
        _warning "No sites configured. ${SITES_CONF} does not exist."
        _echo "  Run: ${CYAN}git-deploy-systemd install${NC} first."
        exit 0
    fi

    local site_names name path user
    site_names=$(get_site_names)

    if [[ -z "${site_names}" ]]; then
        _warning "No sites registered."
        return 0
    fi

    echo ""
    _divider
    _echo "${BOLD}${WHITE}  Registered Sites${NC}"
    _divider
    echo ""
    local name_w path_w user_w
    _compute_site_table_widths
    printf "  %-${name_w}s %-${path_w}s %-${user_w}s\n" "NAME" "PATH" "USER"
    _print_table_divider
    for name in ${site_names}; do
        path=$(get_site_path "${name}")
        user=$(get_site_user "${name}")
        printf "  %-${name_w}s %-${path_w}s %-${user_w}s\n" "${name}" "${path}" "${user}"
    done
    echo ""
}

# -- Restart -------------------------------------------------------------
cmd_restart() {
    require_root
    _debugf "cmd_restart: entering"

    _notice "Restarting ${SERVICE_NAME}..."

    if ! systemctl cat "${SERVICE_NAME}" &>/dev/null; then
        _error "Service ${SERVICE_NAME} is not installed. Run: git-deploy-systemd install"
        exit 1
    fi

    # Regenerate watcher to pick up any manual config changes
    if [[ -f "${SITES_CONF}" ]]; then
        generate_watcher_script
        write_sudoers
    fi

    run_systemctl restart "${SERVICE_NAME}" 2>/dev/null || {
        _log "restart: FAILED to restart service"
        _error "Failed to restart ${SERVICE_NAME}."
        _echo "  Check status: ${CYAN}systemctl status ${SERVICE_NAME}${NC}"
        exit 1
    }

    if service_is_active; then
        _log "restart: service restarted successfully"
        _success "Service restarted successfully."
    else
        _log "restart: service restarted but not active"
        _warning "Service restarted but is not active. Check: systemctl status ${SERVICE_NAME}"
    fi
}

# ==============================================================================
# PLUGIN HELPERS
# ==============================================================================

# -- Read plugin installs from JSON file ---------------------------------
plugin_get_installs() {
    if [[ ! -f "${PLUGIN_INSTALLS_CONF}" ]]; then
        echo '{"installs":[]}'
        return 0
    fi
    cat "${PLUGIN_INSTALLS_CONF}" 2>/dev/null || echo '{"installs":[]}'
}

# -- Write plugin installs to JSON file ----------------------------------
plugin_save_installs() {
    local data="$1"
    run mkdir -p "${CONFIG_DIR}" 2>/dev/null || true
    if [[ "${DRY_RUN}" != "true" ]]; then
        echo "${data}" > "${PLUGIN_INSTALLS_CONF}"
    fi
}

# -- Resolve the mu-plugin source path -----------------------------------
plugin_get_source_path() {
    local source=""
    if [[ -f "${BINARY_CONF}" ]]; then
        source=$(grep '^plugin_source=' "${BINARY_CONF}" 2>/dev/null | cut -d= -f2-)
    fi
    if [[ -z "${source}" ]]; then
        # Fallback: derive from binary_source
        local bin_source
        bin_source=$(grep '^binary_source=' "${BINARY_CONF}" 2>/dev/null | cut -d= -f2-)
        if [[ -n "${bin_source}" ]]; then
            source="${bin_source}.php"
        else
            # Last resort: use the installed path
            source="${PLUGIN_PATH}"
        fi
    fi
    echo "${source}"
}

# -- Plugin --------------------------------------------------------------
cmd_plugin() {
    require_root
    _debugf "cmd_plugin: entering, args: $*"

    local subcmd=""
    subcmd="${1:-}"
    shift 2>/dev/null || true

    case "${subcmd}" in
        add)
            cmd_plugin_add "$@"
            ;;
        remove|rm)
            cmd_plugin_remove "$@"
            ;;
        update)
            cmd_plugin_update "$@"
            ;;
        ""|list|ls)
            cmd_plugin_list
            ;;
        *)
            _error "Unknown plugin subcommand: ${subcmd}"
            _echo "Usage: git-deploy-systemd plugin [add|remove|update|list]"
            exit 1
            ;;
    esac
}

# -- Plugin: list --------------------------------------------------------
cmd_plugin_list() {
    _debugf "cmd_plugin_list: entering"

    local plugin_source
    plugin_source=$(plugin_get_source_path)
    local plugin_md5=""
    if [[ -f "${plugin_source}" ]]; then
        plugin_md5=$(md5sum "${plugin_source}" 2>/dev/null | awk '{print $1}')
    fi

    echo ""
    _divider
    _echo "${BOLD}${WHITE}  git-deploy-systemd plugin — MU-Plugin Installs${NC}"
    _divider
    echo ""

    if [[ -f "${plugin_source}" ]]; then
        _info "MU-Plugin source: ${plugin_source} (md5: ${plugin_md5})"
    else
        _warning "MU-Plugin source not found. Run install or specify with --from."
    fi
    echo ""

    local installs_json
    installs_json=$(plugin_get_installs)
    local count
    count=$(echo "${installs_json}" | jq -r '.installs | length' 2>/dev/null || echo "0")

    if [[ "${count}" -eq 0 ]]; then
        _warning "No plugin installs registered."
        _echo "  Register one with: ${CYAN}git-deploy-systemd plugin add --path /var/www/site1${NC}"
        return 0
    fi

    # Compute dynamic column widths
    local label_w=6 path_w=6 user_w=6
    for row in $(echo "${installs_json}" | jq -r '.installs[] | "\(.label)|\(.path)|\(.user)"' 2>/dev/null); do
        local row_label row_path row_user
        row_label=$(echo "${row}" | cut -d'|' -f1)
        row_path=$(echo "${row}" | cut -d'|' -f2)
        row_user=$(echo "${row}" | cut -d'|' -f3)
        [[ ${#row_label} -gt ${label_w} ]] && label_w=${#row_label}
        [[ ${#row_path} -gt ${path_w} ]] && path_w=${#row_path}
        [[ ${#row_user} -gt ${user_w} ]] && user_w=${#row_user}
    done
    label_w=$((label_w + 2))
    path_w=$((path_w + 2))
    user_w=$((user_w + 2))

    _info "Registered installs (${count}):"
    echo ""

    # Print table
    printf "  %-${label_w}s %-${path_w}s %-${user_w}s\n" "LABEL" "WP PATH" "USER"
    local label_dashes path_dashes user_dashes
    label_dashes=$(printf '%*s' "${label_w}" '' | tr ' ' '-')
    path_dashes=$(printf '%*s' "${path_w}" '' | tr ' ' '-')
    user_dashes=$(printf '%*s' "${user_w}" '' | tr ' ' '-')
    printf "  %-${label_w}s %-${path_w}s %-${user_w}s\n" \
        "${label_dashes}" "${path_dashes}" "${user_dashes}"

    for row in $(echo "${installs_json}" | jq -r '.installs[] | "\(.label)|\(.path)|\(.user)"' 2>/dev/null); do
        row_label=$(echo "${row}" | cut -d'|' -f1)
        row_path=$(echo "${row}" | cut -d'|' -f2)
        row_user=$(echo "${row}" | cut -d'|' -f3)
        printf "  %-${label_w}s %-${path_w}s %-${user_w}s\n" "${row_label}" "${row_path}" "${row_user}"
    done
    echo ""
}

# -- Plugin: add ---------------------------------------------------------
cmd_plugin_add() {
    _debugf "cmd_plugin_add: entering, args: $*"

    local site_path=""
    local site_label=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --path)
                site_path="$2"
                shift 2
                ;;
            --label)
                site_label="$2"
                shift 2
                ;;
            *)
                shift
                ;;
        esac
    done

    # Require both flags
    if [[ -z "${site_path}" || -z "${site_label}" ]]; then
        _error "Both --path and --label are required."
        _echo "  Usage: git-deploy-systemd plugin add --path <wordpress-root> --label <name>"
        exit 1
    fi

    # Normalize path
    site_path=$(realpath "${site_path}" 2>/dev/null || echo "${site_path}")

    # Validate it looks like a WordPress install
    if [[ ! -d "${site_path}/wp-content" ]]; then
        _error "Not a WordPress install: ${site_path}/wp-content does not exist."
        exit 1
    fi
    if [[ ! -d "${site_path}/wp-content/mu-plugins" ]]; then
        _warning "mu-plugins directory does not exist. Creating it..."
        run mkdir -p "${site_path}/wp-content/mu-plugins"
    fi

    # Detect ownership of mu-plugins directory
    local wp_user wp_group
    wp_user=$(stat -c '%U' "${site_path}/wp-content/mu-plugins" 2>/dev/null || echo "root")
    wp_group=$(stat -c '%G' "${site_path}/wp-content/mu-plugins" 2>/dev/null || echo "root")
    _info "mu-plugins owner: ${wp_user}:${wp_group}"

    # Use the provided label directly
    local label="${site_label}"

    # Confirm
    echo ""
    _notice "About to install mu-plugin:"
    _echo "  Source:      $(plugin_get_source_path)"
    _echo "  Destination: ${site_path}/wp-content/mu-plugins/git-deploy-systemd.php"
    _echo "  Owner:       ${wp_user}:${wp_group}"
    echo ""
    read -r -p "Proceed? [Y/n] " confirm
    if [[ -n "${confirm}" && "${confirm}" != "y" && "${confirm}" != "Y" ]]; then
        _notice "Install cancelled."
        exit 0
    fi

    # Get source path
    local plugin_source
    plugin_source=$(plugin_get_source_path)
    if [[ ! -f "${plugin_source}" ]]; then
        _error "Source mu-plugin not found at: ${plugin_source}"
        _echo "  Make sure git-deploy-systemd is installed first."
        exit 1
    fi

    # Copy the file
    run cp "${plugin_source}" "${site_path}/wp-content/mu-plugins/git-deploy-systemd.php"
    run chown "${wp_user}:${wp_group}" "${site_path}/wp-content/mu-plugins/git-deploy-systemd.php" 2>/dev/null || true
    _success "Installed to ${site_path}/wp-content/mu-plugins/git-deploy-systemd.php"

    # Record in plugin-installs.json
    local installs_json
    installs_json=$(plugin_get_installs)

    # Check if this path is already registered
    local existing
    existing=$(echo "${installs_json}" | jq -r --arg p "${site_path}" '.installs[] | select(.path == $p) | .path' 2>/dev/null)
    if [[ -n "${existing}" ]]; then
        _info "Path already registered. Updating install record."
        installs_json=$(echo "${installs_json}" | jq -r --arg p "${site_path}" --arg u "${wp_user}" --arg g "${wp_group}" \
            '(.installs[] | select(.path == $p) | .user) = $u | (.installs[] | select(.path == $p) | .group) = $g' 2>/dev/null)
    else
        local new_entry
        new_entry=$(jq -n \
            --arg p "${site_path}" \
            --arg pp "${site_path}/wp-content/mu-plugins/git-deploy-systemd.php" \
            --arg md "wp-content/mu-plugins" \
            --arg u "${wp_user}" \
            --arg g "${wp_group}" \
            --arg l "${label}" \
            --arg d "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
            '{label: $l, path: $p, plugin_path: $pp, mu_dir: $md, user: $u, group: $g, installed_at: $d}' 2>/dev/null)
        installs_json=$(echo "${installs_json}" | jq -r --argjson ne "${new_entry}" '.installs += [$ne]' 2>/dev/null)
    fi

    plugin_save_installs "${installs_json}"
    _log "plugin: added install at ${site_path} (user=${wp_user})"
    _success "Plugin install registered."
}

# -- Plugin: remove ------------------------------------------------------
cmd_plugin_remove() {
    _debugf "cmd_plugin_remove: entering, args: $*"

    local site_path=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --path)
                site_path="$2"
                shift 2
                ;;
            *)
                shift
                ;;
        esac
    done

    if [[ -z "${site_path}" ]]; then
        _error "Usage: git-deploy-systemd plugin remove --path <wordpress-root>"
        exit 1
    fi

    site_path=$(realpath "${site_path}" 2>/dev/null || echo "${site_path}")

    local installs_json
    installs_json=$(plugin_get_installs)

    local found
    found=$(echo "${installs_json}" | jq -r --arg p "${site_path}" '.installs | map(select(.path == $p)) | length' 2>/dev/null)

    if [[ "${found}" -eq 0 ]]; then
        _error "No plugin install found at: ${site_path}"
        exit 1
    fi

    echo ""
    _warning "Removing plugin install record for: ${site_path}"
    _echo "  Note: The actual plugin file will NOT be deleted."
    read -r -p "Confirm? [y/N] " confirm
    if [[ "${confirm}" != "y" && "${confirm}" != "Y" ]]; then
        _notice "Remove cancelled."
        exit 0
    fi

    installs_json=$(echo "${installs_json}" | jq -r --arg p "${site_path}" \
        '.installs |= map(select(.path != $p))' 2>/dev/null)
    plugin_save_installs "${installs_json}"
    _log "plugin: removed install at ${site_path}"
    _success "Plugin install record removed."
}

# -- Plugin: update ------------------------------------------------------
cmd_plugin_update() {
    _debugf "cmd_plugin_update: entering, args: $*"

    local single_path=""
    local force=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --path)
                single_path="$2"
                shift 2
                ;;
            --force)
                force=1
                shift
                ;;
            *)
                shift
                ;;
        esac
    done

    local plugin_source
    plugin_source=$(plugin_get_source_path)

    if [[ ! -f "${plugin_source}" ]]; then
        _error "Source mu-plugin not found at: ${plugin_source}"
        _echo "  Make sure git-deploy-systemd is installed first."
        exit 1
    fi

    local src_md5
    src_md5=$(md5sum "${plugin_source}" 2>/dev/null | awk '{print $1}')

    echo ""
    _divider
    _echo "${BOLD}${WHITE}  git-deploy-systemd plugin update${NC}"
    _divider
    echo ""
    _info "Source: ${plugin_source} (md5: ${src_md5})"
    echo ""

    local installs_json
    installs_json=$(plugin_get_installs)

    local filter=""
    if [[ -n "${single_path}" ]]; then
        single_path=$(realpath "${single_path}" 2>/dev/null || echo "${single_path}")
        filter=$(echo "${installs_json}" | jq -r --arg p "${single_path}" \
            '{installs: [.installs[] | select(.path == $p)]}' 2>/dev/null)
        if [[ -z "${filter}" || "$(echo "${filter}" | jq -r '.installs | length')" -eq 0 ]]; then
            _error "No install found at: ${single_path}"
            exit 1
        fi
        installs_json="${filter}"
    fi

    local total updated=0 skipped=0 failed=0
    total=$(echo "${installs_json}" | jq -r '.installs | length' 2>/dev/null || echo "0")
    _info "Checking ${total} install(s)..."

    for row in $(echo "${installs_json}" | jq -r '.installs[] | "\(.path)|\(.user)|\(.group)"' 2>/dev/null); do
        local wp_root wp_user wp_group dest_path
        wp_root=$(echo "${row}" | cut -d'|' -f1)
        wp_user=$(echo "${row}" | cut -d'|' -f2)
        wp_group=$(echo "${row}" | cut -d'|' -f3)
        dest_path="${wp_root}/wp-content/mu-plugins/git-deploy-systemd.php"

        echo ""

        # Check if destination exists
        if [[ ! -f "${dest_path}" ]]; then
            _warning "Plugin file missing at ${dest_path}. Adding it..."
        fi

        # Check md5sum (skip if file missing — avoids set -e exit on md5sum failure)
        local dst_md5=""
        if [[ -f "${dest_path}" ]]; then
            dst_md5=$(md5sum "${dest_path}" 2>/dev/null | awk '{print $1}')
        fi
        _debugf "plugin_update: ${wp_root} src=${src_md5} dst=${dst_md5}"

        if [[ "${force}" == "1" || "${src_md5}" != "${dst_md5}" ]]; then
            if [[ "${force}" == "1" ]]; then
                _notice "Forcing update: ${dest_path}"
            else
                _notice "Updating: ${dest_path}"
            fi

            run cp "${plugin_source}" "${dest_path}"
            run chown "${wp_user}:${wp_group}" "${dest_path}" 2>/dev/null || true

            if [[ -f "${dest_path}" ]]; then
                _success "Updated ${dest_path}"
                _log "plugin: updated install at ${wp_root}"
                ((updated++))
            else
                _error "Failed to write ${dest_path}"
                ((failed++))
            fi
        else
            _info "Up to date: ${dest_path} (md5 match)"
            ((skipped++))
        fi
    done

    echo ""
    _divider
    _echo "${GREEN}${BOLD}  Plugin update complete.${NC}"
    _divider
    echo ""
    _echo "  Total:   ${total}"
    _echo "  Updated: ${updated}"
    _echo "  Skipped: ${skipped}"
    if [[ "${failed}" -gt 0 ]]; then
        _echo "  ${RED}Failed:  ${failed}${NC}"
    fi
    echo ""
}

# -- Help ----------------------------------------------------------------
cmd_help() {
    cat << 'HELP'
git-deploy-systemd — Manage inotify-based git pull watcher via systemd

USAGE:
  git-deploy-systemd [--debug]               Show status
  git-deploy-systemd [--debug] install       Install service and dependencies
  git-deploy-systemd [--debug] adopt         Take over an existing install
  git-deploy-systemd [--debug] uninstall     Remove service and all configuration
  git-deploy-systemd [--debug] add           Register a new site
  git-deploy-systemd [--debug] remove <path> Unregister a site
  git-deploy-systemd [--debug] list          List all registered sites
  git-deploy-systemd [--debug] version       Show the installed version
  git-deploy-systemd [--debug] restart       Restart the watcher service
  git-deploy-systemd [--debug] update        Update the installed binary from source
  git-deploy-systemd [--debug] update-all    Update binary, watcher, and WordPress sites
  git-deploy-systemd [--debug] plugin        Manage MU-Plugin installs on WordPress sites
  git-deploy-systemd help                    Show this help

OPTIONS:
  --debug    Enable verbose debug output to stderr (can appear anywhere in args)
  --dry-run  Print what install/update/adopt/remove would do, without changing anything

COMMANDS:
  install     Install inotify-tools, create directories, write systemd unit,
              enable the watcher service.
    --force   Skip confirmation prompts.

  adopt       Detect an existing install, back up its files, install this
              binary to /usr/local/sbin, and regenerate watcher/service while
              preserving sites.conf. Use on an unknown-version deployment.
    --force   Skip the confirmation prompt.

  uninstall   Stop/disable service, remove all files and configuration.
              Leaves inotify-tools and .git-pull-trigger files in place.
    --force          Skip confirmation prompts.
    --keep-triggers  Leave .git-pull-trigger files in each repo.

  add         Register a new site to watch for git pull triggers.
    --path    Absolute path to the git repository.
    --user    System user to run git pull as.
    --name    Optional label for the site (defaults to directory name).
    --write-commit-info
              Write git commit info to a JSON file after each deploy.
              This file is used by the WordPress plugin to display a
              deploy banner. Optional; disabled by default.

  remove      Unregister a site by its repository path.

  update      Update the installed binary. With no source flag it prefers
              the recorded upstream URL, then the recorded local source.
              Also re-checks dependencies, regenerates watcher, and
              restarts the service.
    --from <path>      Update from a local file path.
    --from-url <url>   Download the binary from a URL.
    --from-git [repo]  Shallow-clone the project repo (default: the upstream
                       git URL) and update from bin/git-deploy-systemd.
    --sha256 <hash>    Verify the downloaded binary hash (with --from-url).
    --force            Force update even if md5sums match.

  update-all  Run both 'update' and 'plugin update' in sequence.
              Updates the binary, watcher, PHP source, then deploys
              the mu-plugin to all registered WordPress sites.

  list        List all registered sites with paths and users.
  version     Print the installed version and exit.
  restart     Regenerate watcher script and restart the service.

  plugin      Manage MU-Plugin deployment to WordPress sites.
    add       Register a WordPress install and copy the mu-plugin.
              --path    WordPress root path (e.g. /var/www/site1).
              --label   Label for the install (e.g. my-site).
    remove    Unregister a WordPress install (does not delete file).
              --path    WordPress root path.
    update    Update the mu-plugin on all registered sites.
              --path    Update only the specified site.
              --force   Force update even if md5sums match.

FILES:
  /usr/local/sbin/git-deploy-systemd         CLI command
  /opt/git-deploy/config/sites.conf          Site configuration
  /opt/git-deploy/config/install.conf        Install record (source + version)
  /opt/git-deploy/git-deploy-watcher.sh      Generated watcher (inotifywait loop)
  /etc/systemd/system/git-deploy-watcher.service  Systemd service unit

EXAMPLE:
  # Install
  git-deploy-systemd install

  # Register a site
  git-deploy-systemd add --path /var/www/site1 --user www-data --name site1

  # Add trigger file to gitignore
  echo ".git-pull-trigger" >> /var/www/site1/.gitignore

  # The watcher now watches /var/www/site1/.git-pull-trigger
  # When the file is touched, git pull runs as www-data in that repo.

HELP
}

# ==============================================================================
# MAIN DISPATCH
# ==============================================================================

main() {
    # Extract --debug / --dry-run from anywhere in the argument list
    local filtered=()
    for arg in "$@"; do
        case "${arg}" in
            --debug)   DEBUG=true ;;
            --dry-run) DRY_RUN=true ;;
            *)         filtered+=("${arg}") ;;
        esac
    done
    set -- "${filtered[@]}"

    local cmd="${1:-}"
    _debugf "main: cmd='${cmd}', remaining args: $*"

    case "${cmd}" in
        install)
            shift
            if [[ "${1:-}" == "--adopt" ]]; then
                shift
                cmd_adopt "$@"
            else
                cmd_install "$@"
            fi
            ;;
        adopt)
            shift
            cmd_adopt "$@"
            ;;
        uninstall)
            shift
            cmd_uninstall "$@"
            ;;
        add)
            shift
            cmd_add "$@"
            ;;
        remove|rm)
            shift
            cmd_remove "${1:-}"
            ;;
        update|upgrade)
            shift
            cmd_update "$@"
            ;;
        update-all|updateall)
            shift
            cmd_update_all "$@"
            ;;
        plugin)
            shift
            cmd_plugin "$@"
            ;;
        list|ls)
            cmd_list
            ;;
        version|--version|-V)
            cmd_version
            ;;
        restart)
            cmd_restart
            ;;
        help|--help|-h)
            cmd_help
            ;;
        "")
            cmd_status
            ;;
        *)
            _error "Unknown command: ${cmd}"
            echo ""
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
